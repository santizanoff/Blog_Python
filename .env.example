# Copia este archivo como .env y completá los valores reales
# NO subas el archivo .env al repositorio

# Clave secreta de Django (generá una nueva con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=django-insecure-reemplaza-con-tu-clave-secreta

# Modo debug (True en desarrollo, False en producción)
DEBUG=True

